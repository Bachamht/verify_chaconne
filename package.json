{
  "name": "chaconne-verify",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "audit:ci": "pnpm audit --prod --audit-level=high",
    "ci": "pnpm lint && pnpm typecheck && pnpm test",
    "db:migrate": "pnpm --filter @chaconne/db db:migrate",
    "release:hash": "node scripts/tree-hash.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "turbo": "^2.10.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "license": "MIT",
  "description": "Chaconne Verify — StockProof + RWA Guard on X Layer (OKX Dev Day 2026)"
}
