# Chaconne Verify service — 独立进程、独立 .env（D-080）。绝不与 poller/web/bot 的 .env 合并。
DATABASE_URL=postgres://verify:CHANGE_ME@127.0.0.1:5432/chaconne
VERIFY_HOST=127.0.0.1
VERIFY_PORT=8790
NODE_ENV=production
PUBLIC_BASE_URL=https://verify.chaconne.xyz

# OKX Onchain OS 开发者门户凭据（RWA/quote/swap + x402 facilitator 共用）
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_API_BASE_URL=https://web3.okx.com

# x402 收款：网络与商户地址；REPORT_PRICE_USD=0 表示免费（先免费上架）
PAYMENT_NETWORK=eip155:1952
MERCHANT_RECIPIENT_ADDRESS=
REPORT_PRICE_USD=0
PAYMENT_MODE=okx

# 证明签名身份（只签 VerificationCertificate；不是资金钱包）
ATTESTATION_PRIVATE_KEY=
SIGNER_EPOCH=1

# 执行链与 Guard（Lane D 部署后填 GUARD_ADDRESS）；路由/授权对象为运营者批准值（the address-approval log (internal) #7 #8）
EXECUTION_CHAIN_ID=196
GUARD_ADDRESS=
ROUTER_ADDRESS=0x7c5bee2a8091c3ef39072f64f18fac913060aeaf
SPENDER_ADDRESS=0x8b773d83bc66be128c60e07e17c8901f7a64f000
XLAYER_RPC_URL=https://rpc.xlayer.tech

# 资产登记：fixture（占位）| file；主网用 config/registry.xlayer.json
REGISTRY_MODE=file
REGISTRY_FILE=config/registry.xlayer.json
# 证据来源：fixture | live（live 需要 OKX 凭据 + FINNHUB_API_KEY，CV-D02）
EVIDENCE_MODE=live
FINNHUB_API_KEY=

# 调用方 API key：逗号分隔 "key:callerId"
VERIFY_API_KEYS=

# 再核验额度 / 对账
ENTITLEMENT_MAX_REFRESHES=2
ENTITLEMENT_WINDOW_SECONDS=300
RECONCILE_INTERVAL_MS=15000
SETTLE_POLL_DEADLINE_MS=5000
# 结算同步等待链上结果（默认 true；false = 异步 pending 即交付，链上失败只能事后对账）
SETTLE_SYNC=true

# 链上回执核实（有 GUARD_ADDRESS 时自动启动；只推进状态，不发交易）
RECEIPT_INTERVAL_MS=10000
RECEIPT_CONFIRMATIONS=6
RECEIPT_UNKNOWN_AFTER_MS=600000

# ---- v2（升级执行计划 v5）----
# PlanGuard v2 合约地址（空 = 授权计划相关接口 503）
PLANGUARD_ADDRESS=
# 商品价格（十进制美元串；审核期一律 0）
PRODUCT_PRICE_PLAN_USD=0
PRODUCT_PRICE_MONITOR_WINDOW_USD=0
PRODUCT_PRICE_TASK_BUNDLE_USD=0
# 监测窗口有效期（秒）与 monitor 轮询间隔（常规时段 / 休市）
MONITOR_WINDOW_SECONDS=86400
MONITOR_INTERVAL_REGULAR_MS=30000
MONITOR_INTERVAL_CLOSED_MS=300000
# 卖出方向：rebasing 股票代币按 amountIn − tolerance 取路由（与 PlanGuard inputShortfallTolerance 一致）
SELL_INPUT_TOLERANCE_WEI=1000000
# 逗号分隔地址：这些付款人/owner 的账单标 selfPayment（自付演示）
DEMO_SELF_PAYMENT_ADDRESSES=

# ---- v6 Lane D · 个人事件台（C6）----
# 能力开关（缺省 true）；事件存储 db（迁移 0018 后）/ memory（本地演示）
AGENT_C6_ENABLED=true
AGENT_C6_STORE=db
# 财报源（Finnhub /calendar/earnings，复用 FINNHUB_API_KEY）：摄入周期、逐只请求间隔、向前覆盖天数
EARNINGS_INGEST_INTERVAL_MS=21600000
EARNINGS_REQUEST_SPACING_MS=1100
EARNINGS_HORIZON_DAYS=120

# ---- v6 Chaconne Agent（能力开关缺省 true；interfaces §11.13）----
# AGENT_C4_ENABLED=true            # C4 组合 / 通知 / 执行器心跳（Lane C）
# AGENT_C5_ENABLED=true            # C5 Crew / Missions / Recap（Lane F）
# AGENT_C6_ENABLED=true            # C6 个人事件台（Lane D）；AGENT_C6_STORE=db|memory
# AGENT_C8_ENABLED=true            # C8 资金组（Lane C）；调仓编排同时需要 C4 与 C8
# AGENT_C9_ENABLED=true            # C9 决策实验（Lane E）
# VERIFY_TG_BOT_TOKEN=             # Telegram 独立推送 bot 的 token（只用于 sendMessage；空 = 链接端点回 not_configured）
# NOTIFY_DISPATCH_INTERVAL_MS=5000 # 通知 outbox 派发间隔
# NOTIFY_WEBHOOK_TIMEOUT_MS=8000   # webhook 请求超时
# PORTFOLIO_PRICE_SOURCE=market    # market=公开行情快照（需 OKX 凭据）| none=只给数量
# EARNINGS_INGEST_INTERVAL_MS / EARNINGS_REQUEST_SPACING_MS=1100 / EARNINGS_HORIZON_DAYS=120   # 财报源摄入（Lane D）
# ---- v6（Chaconne Agent）----
# C5 Crew / Missions / Recap（缺省 true；false = /v1/recaps* 与 /v1/missions 不挂载，页面显示「尚未就绪」）
AGENT_C5_ENABLED=true
# ---- v6 Lane B · 上下文摄入 / 任务 / 条件 / 理由卡（能力开关 AGENT_C1/C2/C3/C7_ENABLED 缺省 true）----
# CROWSNEST_CONTEXT_URL=http://127.0.0.1:<端口>/context/context.json   # 同机走本机回环（全字段版，绝不公开）
# CROWSNEST_EVENTS_URL=http://127.0.0.1:<端口>/context/events.json
# CROWSNEST_PUBKEY_ED25519=crowsnest-ctx-k1=<服务器公钥 hex>          # 形如 id=hex，只是公钥；验签失败整份拒收
# CONTEXT_POLL_INTERVAL_MS=300000
