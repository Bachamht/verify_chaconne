# Chaconne Verify · 平台执行身份（D-089；interfaces §12.12）。本文件只列变量名，值全部留空。
# 执行身份只装 OKB gas，只对 PlanGuard.executeStep 与登记代币 permit 发交易，永远收不到用户资产。
VERIFY_SERVICE_URL=http://127.0.0.1:8790
VERIFY_EXECUTOR_API_KEY=
# eoa | okx_agentic
EXECUTOR_MODE=eoa
# 只在 EXECUTOR_MODE=eoa 时需要；这把私钥只能在本进程的 .env（权限 600），绝不进任何文档、聊天、日志
EXECUTOR_PRIVATE_KEY=
XLAYER_RPC_URL=https://rpc.xlayer.tech
EXECUTION_CHAIN_ID=196
PLANGUARD_ADDRESS=
REGISTRY_FILE=
# 必填（eoa 模式）：执行身份 OKB 余额低于此值即停止领取并上报 executor_gas_low；未配置或为 0 拒绝启动（运营者确认 2026-10-02）
EXECUTOR_MIN_OKB_WEI=
# 每笔费用上限（D-089 修订；超任一项 → preflight_failed fee_cap_exceeded，不签名、不广播）。留空 = 用下列缺省值。
# 缺省值依据：2026-10-02 只读 RPC 实测 baseFee 0.02 gwei、priority 1 wei、l1Fee 0；executeStep 约 61 万 gas（详见 packages/verify-exec/src/fees.ts）
# EXECUTOR_MAX_GAS_LIMIT=1500000
# EXECUTOR_MAX_FEE_PER_GAS_WEI=200000000
# EXECUTOR_MAX_PRIORITY_FEE_PER_GAS_WEI=20000000
# EXECUTOR_MAX_FEE_PER_TX_WEI=200000000000000
EXECUTOR_MAX_GAS_LIMIT=
EXECUTOR_MAX_FEE_PER_GAS_WEI=
EXECUTOR_MAX_PRIORITY_FEE_PER_GAS_WEI=
EXECUTOR_MAX_FEE_PER_TX_WEI=
EXECUTOR_POLL_MS=1000
EXECUTOR_MIN_CERT_REMAINING_S=8
# 逗号分隔：证明签名者、部署者、商户、演示钱包等角色地址；执行身份地址落在其中即拒启
FORBIDDEN_EXECUTOR_ADDRESSES=
# 只在 EXECUTOR_MODE=okx_agentic 时需要：官方 CLI 路径（命令与参数以安装版本的官方文档为准）
OKX_AGENTIC_CLI=
# 只在 EXECUTOR_MODE=okx_agentic 时需要：Agentic Wallet 的执行身份地址（不是私钥）
EXECUTOR_AGENTIC_ADDRESS=
