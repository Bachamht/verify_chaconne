# Chaconne Verify MCP（stdio）。默认形态：只需服务地址与调用方 key，没有任何私钥。
VERIFY_SERVICE_URL=https://verify.chaconne.xyz
VERIFY_API_KEY=
# 可选：当 key 为 "web:*" 通配时按钱包地址隔离（agent-wallet 模式下默认取钱包地址）
VERIFY_CALLER=
XLAYER_RPC_URL=https://rpc.xlayer.tech

# ---- agent-wallet 模式（CV-D08，可选）：这是**你自己的 Agent 钱包**，只在这个客户端进程里，服务端永远拿不到 ----
# 三项必须同时给，缺一拒绝启动。启用后：x402 自动付款（累计 ≤ MAX_SPEND）、可代签 TradeMandate（v6 authorize_task 同样以 MAX_SPEND 为 budgetCap 上限）、
# 可发送 PlanGuard.executeStep（仅允许的链）、每 60 s 自动向 /v1/mandates/:id/executor/heartbeat 报在线（只针对本进程授权/执行过的 mandate）。
# 护栏：除 AGENT_WALLET_PRIVATE_KEY 外，任何 *PRIVATE_KEY* / MNEMONIC / SEED_PHRASE 环境变量都会让进程拒绝启动。
# AGENT_WALLET_PRIVATE_KEY=0x...
# AGENT_WALLET_MAX_SPEND_USD=0.10
# AGENT_WALLET_CHAIN_IDS=196,1952
